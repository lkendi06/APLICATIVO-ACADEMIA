# Copie este arquivo para `.env` e preencha com os dados do seu projeto Supabase.
# Supabase Dashboard → Project Settings → API.
#
# Apenas a URL e a chave pública (anon / publishable) vão para o app.
# NUNCA coloque a chave `service_role` (secreta) aqui: tudo que começa com
# EXPO_PUBLIC_ é embutido no aplicativo e pode ser lido por qualquer pessoa.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
